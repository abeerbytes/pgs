# Public configuration only. Anything starting with VITE_ is visible to every visitor.
# Never put passwords, API secrets or spreadsheet IDs here.

# The Web App URL you get after deploying the Apps Script (ends with /exec)
VITE_GOOGLE_SCRIPT_URL=

# Your live website address, e.g. https://your-site.vercel.app (used for canonical links and social previews)
VITE_SITE_URL=

# Only used while no Google Sheet is connected ("local mode"): store WhatsApp number, international format, digits only
VITE_WHATSAPP_NUMBER=
